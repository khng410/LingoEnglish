<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/colorBackground">

    <!-- Icon/Hình ảnh minh hoạ (Có thể thay bằng Lottie sau) -->
    <ImageView
        android:id="@+id/imgTrophy"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_leaderboard"
        app:tint="@color/colorPrimaryDark" />

    <TextView
        android:id="@+id/tvComboTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgTrophy"
        android:layout_marginTop="24dp"
        android:text="Combo 2 skills!"
        android:textAlignment="center"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Đoạn mô tả 100-150 từ -->

    <!-- Nút Bắt đầu -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvComboTitle"
        android:layout_marginTop="25dp"
        android:lineSpacingExtra="6dp"
        android:text="Welcome to the 2 skills challenge include Listening and Reading🌟\n\n\n Are you ready? Take a deep breath and let's get start!!!"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCombo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text="BẮT ĐẦU NGAY"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="16dp" />

</RelativeLayout>
