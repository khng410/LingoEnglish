<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/colorBackground">

    <!-- Icon/Hình ảnh minh hoạ (Có thể thay bằng Lottie sau) -->
    <ImageView
        android:id="@+id/imgTrophy"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_leaderboard"
        app:tint="@color/colorPrimaryDark" />

    <TextView
        android:id="@+id/tvComboTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgTrophy"
        android:layout_marginTop="24dp"
        android:text="Combo 4 Kỹ Năng!"
        android:textAlignment="center"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Đoạn mô tả 100-150 từ -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvComboTitle"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="6dp"
        android:text="Chào mừng bạn đến với Thử Thách Toàn Diện! 🌟\n\nTrong chế độ này, bạn sẽ trải qua liên tiếp 4 phần thi: Nghe, Nói, Đọc và Viết. Đây là bài rèn luyện hoàn hảo để mô phỏng một kỳ thi thực tế và giúp bạn kiếm được lượng XP khổng lồ.\n\n🎧 Kỹ năng đầu tiên sẽ là Listening (Nghe). Bạn sẽ nghe một đoạn hội thoại hoặc podcast ngắn. Hãy đảm bảo bạn đang ở không gian yên tĩnh, tăng âm lượng hoặc đeo tai nghe vào nhé.\n\nĐã sẵn sàng chưa? Hãy hít một hơi thật sâu và bắt đầu chinh phục thử thách nào!"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp" />

    <!-- Nút Bắt đầu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCombo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text="BẮT ĐẦU NGAY"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="16dp" />

</RelativeLayout>
