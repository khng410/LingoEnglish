<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/colorBackground">

    <!-- Icon/Hình ảnh minh hoạ (Có thể thay bằng Lottie sau) -->

    <!-- Đoạn mô tả 100-150 từ -->

    <!-- Nút Bắt đầu -->

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieMode"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/corgi_animation6" />

    <TextView
        android:id="@+id/tvComboTitle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="60dp"
        android:text="Combo 2 skills!"
        android:textAlignment="center"
        android:textColor="@color/colorPrimaryDark"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvComboTitle"
        android:layout_marginTop="245dp"

        android:text="Welcome to the 2 skills challenge include Listening and Reading🌟\n\n\n Are you ready? Take a deep breath and let's get start!!!"
        android:textColor="@color/colorTextPrimary"
        android:textSize="10sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartCombo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text="START!"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#71B324"
        app:cornerRadius="16dp" />

</RelativeLayout>
