<?xml version="1.0" encoding="utf-8"?>
<!-- Câu chào mừng -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Hi there! 👋"
    android:textColor="@color/colorTextPrimary"
    android:textSize="24sp"
    android:textStyle="bold" />

<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="4dp"
android:layout_marginBottom="24dp"
android:text="What do you want to learn today?"
android:textColor="@color/colorTextSecondary"
android:textSize="16sp" />

    <!-- HÀNG 1: GIÁO DỤC & CÔNG NGHỆ -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="150dp"
android:orientation="horizontal"
android:weightSum="2">

<!-- Nút Giáo dục (CardView bo góc 16dp, có đổ bóng) -->
<androidx.cardview.widget.CardView
    android:id="@+id/cardEducation"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/colorEducation"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_education"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Education"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

<!-- Nút Công nghệ -->
<androidx.cardview.widget.CardView
    android:id="@+id/cardTech"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="10dp"
    android:layout_marginBottom="10dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/colorTech"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_tech"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Technology"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>

    <!-- HÀNG 2: DU LỊCH & VIỆC LÀM -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="150dp"
android:orientation="horizontal"
android:weightSum="2">

<!-- Nút Du lịch -->
<androidx.cardview.widget.CardView
    android:id="@+id/cardTravel"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/colorTravel"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_travel"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Travel"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

<!-- Nút Việc làm -->
<androidx.cardview.widget.CardView
    android:id="@+id/cardJob"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_marginStart="10dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/colorJob"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_job"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Jobs"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
</LinearLayout>
