<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Thanh ngang nhỏ ở trên cùng (Handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Chọn một kỹ năng"
        android:textAlignment="center"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Lưới 2x2 cho 4 kỹ năng -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2">

        <!-- Nút Listening -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="Nghe (Listening)"
            app:cornerRadius="12dp"
            app:strokeColor="#29B6F6" />

        <!-- Nút Speaking -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeak"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="Nói (Speaking)"
            app:cornerRadius="12dp"
            app:strokeColor="#AB47BC" />

        <!-- Nút Reading -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRead"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="Đọc (Reading)"
            app:cornerRadius="12dp"
            app:strokeColor="#66BB6A" />

        <!-- Nút Writing -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWrite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="8dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:text="Viết (Writing)"
            app:cornerRadius="12dp"
            app:strokeColor="#EF5350" />
    </GridLayout>

</LinearLayout>
