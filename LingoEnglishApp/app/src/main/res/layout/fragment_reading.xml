<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Header chứa nút Back, Tiêu đề và 2 Nút Zoom -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/tvLessonTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Reading: The Future"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nút thu nhỏ chữ (-) -->
        <ImageView
            android:id="@+id/btnZoomOut"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_bottom_sheet"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_rew"
            app:tint="@color/colorPrimaryDark" />

        <!-- Nút phóng to chữ (+) -->
        <ImageView
            android:id="@+id/btnZoomIn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_bottom_sheet"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_ff"
            app:tint="@color/colorPrimaryDark" />
    </LinearLayout>

    <!-- NỬA TRÊN: BÀI ĐỌC (Cố định ở 50% màn hình, có thể cuộn trong khung) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/tvReadingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"
                android:padding="20dp"
                android:text="Đang tải bài đọc..."
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- ĐƯỜNG KẺ CHIA ĐÔI MÀN HÌNH -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E0E0E0" />

    <!-- NỬA DƯỚI: TRẮC NGHIỆM (Chiếm 50% màn hình, có thể cuộn độc lập) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_bottom_sheet">

        <LinearLayout
            android:id="@+id/quizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tvQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/colorEducation"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp">

                <RadioButton android:id="@+id/rbA" android:textColor="@color/black" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
                <RadioButton android:id="@+id/rbB" android:textColor="@color/black" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
                <RadioButton android:id="@+id/rbC" android:textColor="@color/black" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
                <RadioButton android:id="@+id/rbD" android:textColor="@color/black" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitQuiz"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="30dp"
                android:text="Submit"
                android:textSize="10sp"
                app:backgroundTint="#E0B7B4"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>